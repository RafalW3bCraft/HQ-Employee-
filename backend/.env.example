# HQ-Employee — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/hq_employee?sslmode=prefer

# ─── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_minimum_32_chars_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Do NOT use * in production.
# Example: https://app.hq.co,https://admin.hq.co
ALLOWED_ORIGINS=*

# ─── Rate Limiting (requests per minute) ──────────────────────────────────────
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_VOICE_TOKEN=10
RATE_LIMIT_TELEPHONY=5

# ─── AssemblyAI ────────────────────────────────────────────────────────────────
# Create at: https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ─── Telephony ────────────────────────────────────────────────────────────────
# E.164 format caller ID shown to outbound call recipients
SIP_CALLER_ID=+15551234567

# ─── RevenueCat ───────────────────────────────────────────────────────────────
# Found at: https://app.revenuecat.com/projects/YOUR_PROJECT/api-keys
REVENUECAT_SECRET_KEY=your_revenuecat_secret_key_here
# Found at: https://app.revenuecat.com/projects/YOUR_PROJECT/integrations/webhooks
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret_here

# ─── Google Calendar (Optional) ───────────────────────────────────────────────
# Required for real meeting bookings. Leave empty to use SimulatedCalendarProvider.
# GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret
# GOOGLE_CALENDAR_REFRESH_TOKEN=your_google_oauth_refresh_token
# GOOGLE_CALENDAR_ID=primary
